qestion 12.
create a playbook that creat a partition, vg, lv, file system, and monut it permenet

answer:
---
- name: create new partition
  hosts: all
  become: true

  tasks:
  - name: create new partition
    parted:
  ​​    device: /dev/vdb
      number: 1
      state: present
      part_start: 1Mib
      part_end: 800MiB

  - name: create vg
      lvg:
    	  vg: vg_database
    	  pvs: /dev/vdb1

  - name: create lv
      lvol:
    	  vg: vg_database
    	  lv: lv_mysql
    	  size: 512m

  - name: create file system
     filesystem:
       fstype: ext4
       dev: /dev/vg_database/lv_mysql

  - name: create dit for mount
    file:
      path: /dir/path
      state: directory

  - name: mount the file system
    mount:
      path: /dir/path
      src: /dev/vg_database/lv_mysql
      fstype: ext4
      state: mounted

